# Copy to .env (git-ignored) and fill in real values, or export these
# directly in your shell / CI secrets store. Never commit real values.

# Frontend origin to test against.
EDUM8_BASE_URL=https://app.edum8.us

# A real, already-verified account on that deployment. Playwright reads
# this from the environment only — it is never hardcoded in any spec
# file, never logged, and never written into a screenshot/trace/report.
EDUM8_TEST_EMAIL=
EDUM8_TEST_PASSWORD=
