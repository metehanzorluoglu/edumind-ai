# Copy this file to .env and adjust for your machine. Never commit a real
# .env with a real LAN IP baked in if this repo is shared — it is gitignored.
#
# Expo inlines EXPO_PUBLIC_* variables into the JS bundle at build/start
# time (see https://docs.expo.dev/guides/environment-variables/) — this is
# NOT a runtime secret store, so never put credentials here.

# Backend API base URL. Set to the unambiguous loopback literal 127.0.0.1
# rather than "localhost" or a LAN IP:
#   - "localhost" can resolve to ::1 (IPv6) first in a browser, and the
#     backend (uvicorn --host 0.0.0.0) only listens on IPv4 — the IPv6
#     attempt then just hangs/fails instead of falling back, which surfaces
#     as a generic "Network request failed" with no HTTP status at all.
#   - a LAN IP (even your own machine's) can be silently blocked by macOS's
#     Local Network browser permission (System Settings > Privacy &
#     Security > Local Network) until a human explicitly grants it.
# 127.0.0.1 needs no DNS/hosts resolution and is exempt from that
# permission, so it always reaches the same IPv4 socket uvicorn binds.
#
# To also open the app from another device on the same Wi-Fi
# (http://<your-LAN-IP>:8081), point this at your dev machine's LAN IP
# instead — find it with `ipconfig getifaddr en0` (macOS Wi-Fi) /
# `hostname -I` (Linux) / `ipconfig` (Windows, "IPv4 Address") — but expect
# to grant that Local Network permission the first time each browser tries.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Build-time default for the Image Generator feature (mirrors the
# backend's IMAGE_GENERATION_ENABLED setting — see rag-backend
# app/config.py + .env.example). The backend's GET /status
# image_generation_enabled field always overrides this once the first
# /status call resolves, so changing it server-side re-gates the UI on
# the next app foreground without a rebuild. Only used during the
# pre-fetch window so the very first paint of an image-gen-aware screen
# already matches the backend's intent instead of flashing the wrong
# button in briefly.
# Values: `true` / `false` (case-insensitive); anything else falls back
# to the same default as not setting it (currently `true`).
EXPO_PUBLIC_IMAGE_GENERATOR_ENABLED=true
