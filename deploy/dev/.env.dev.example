# ============================================================================
# Raspberry Pi 5 deployment env file (canonical source of truth for Pi runtime).
# ============================================================================
#
# DO NOT USE this file directly — copy to `.env.rpi5` and fill in the
# placeholders marked `<PI_*>` and `<SET_BY_SETUP_SH>`. The `rpi5-setup.sh`
# helper generates `.env.rpi5` from this template interactively, generating
# a fresh `JWT_SECRET` and asking the operator for the LAN IP / frontend
# URL. Running the backend with a never-filled `.env.rpi5.example` copy
# would have `JWT_SECRET=replace-me`, which the app's `min_length=16`
# validator (`app/config.py:140`) would refuse outright — that's a feature,
# not a bug, since a never-touched secret is by definition not secret.
#
# Production gates wired elsewhere: setting `APP_ENV=production` here is
# what hard-refuses `/auth/dev-login` regardless of the
# `AUTH_DEV_LOGIN_ENABLED` flag (see `app/api/routes_auth.py:55`).
#
# Every key below has been verified against `app/config.py`'s field names;
# the pydantic-settings mapping is snake_case in code → UPPER_SNAKE_CASE
# in the environment.

# --- Runtime mode (must be production on the Pi) ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Bind address inside the container (Compose publishes 8000 to host) ---
HOST=0.0.0.0
PORT=8000

# --- CORS allowlist: exact-string match per app/main.py CORSMiddleware ---
# The Expo native app reaches the backend via `EXPO_PUBLIC_API_BASE_URL`
# which can be on any LAN IP. List every concrete origin the web bundle
# might be opened from (port included — different port = different origin).
# rpi5-setup.sh replaces `<PI_LAN_HOST>` with the fronted's real LAN IP.
# REMOVE the entries you don't need once deployment starts; this list is
# the only place a CORS-misconfigured browser fails silently.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082

# --- Ollama (sibling container on compose-internal network) ---
OLLAMA_BASE_URL=http://ollama:11434

# Pi 5 / 8GB-friendly models: 4B text + 3B vision + the existing embed.
# Larger variants (qwen3:8b, qwen2.5vl:7b) are the default for desktop dev
# but consistently exceed Pi 5's RAM budget when running concurrent.
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=mxbai-embed-large

# --- Vision pipeline (the same path as the text model — the dedicated ---
# --- vision LLM is what does multimodal message understanding). ---
VISION_ENABLED=true
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# Caps/latency tuning — defaults already conservative; only lower on Pi
# if we observe specific failure modes (e.g. requests timeout mid-batch).
VISION_MAX_IMAGES_PER_MESSAGE=4
VISION_MAX_IMAGE_BYTES=10485760
VISION_MAX_PDF_PAGES=10
VISION_REQUEST_TIMEOUT_SECONDS=180

# --- Image generation ---
# Per spec: image generation is OFF on the Pi. The Ollama fleet doesn't
# need `x/flux2-klein` (≥5 GB disk + multi-second per image), the frontend
# auto-hides image-gen UI via the dev tools we just shipped (see
# rag-backend/app/main.py's `if settings.image_generation_enabled:` gate
# around the /images router), and every POST /images/* returns 404
# because the router isn't mounted. Leave IMAGE_GENERATION_ENABLED=false
# unless x/flux2-klein is later pulled and intended to be available.
IMAGE_GENERATION_ENABLED=false
# Kept for symmetry with .env.example; unused as long as the line above
# is false. Override only if IMAGE_GENERATION_ENABLED is flipped to true.
OLLAMA_IMAGE_MODEL=x/flux2-klein
IMAGE_GENERATION_REQUEST_TIMEOUT_SECONDS=300
IMAGE_GENERATION_MAX_IMAGES=4

# --- Chat attachments (on /data — Docker named volume `backend-data`) ---
CHAT_ATTACHMENTS_DIR=/data/chat-attachments
CHAT_ATTACHMENT_MAX_BYTES=10485760
CHAT_ATTACHMENT_MAX_FILES_PER_MESSAGE=5
CHAT_ATTACHMENT_MAX_PDF_PAGES=50
CHAT_ATTACHMENT_ALLOW_HEIC=false

# --- Qdrant ---
# `server` mode because we run qdrant as its own container; the bare
# `local` mode would mean the backend embeds a second qdrant for no
# reason. The container name `qdrant` is the compose-internal hostname
# (`name: edumind-rpi5`); Docker's network DNS resolves it.
QDRANT_MODE=server
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=education_research

# --- Database (sqlite at /data/app.db — see backend-data volume) ---
# Four slashes: three for the URL scheme's `///` (absolute path) plus
# the leading slash of `/data/app.db`. Critical — sqlite sqlalchemy
# interprets `sqlite:///relative.db` and `sqlite:////data/app.db`
# differently (the latter is absolute).
DATABASE_URL=sqlite:////data/app.db

# --- Auth: JWT signing secret ---
# Required; the pydantic validator refuses any value shorter than 16
# characters (see `app/config.py:jwt_secret: Field(min_length=16)`).
# rpi5-setup.sh generates this via `python -c 'import secrets; ...'`;
# DO NOT hand-write or reuse a value committed to git history.
JWT_SECRET=<SET_BY_SETUP_SH>
JWT_ACCESS_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# --- Auth: OAuth providers ---
# All blank by default — the Settings screen's "Continue with …" buttons
# disappear entirely when no providers are configured (see
# app/api/routes_auth.py's providers response). Fill in only if you have
# already registered each provider in its developer console AND updated
# the OAuth redirect-URI allowlist to include the Pi's URL. Leaving these
# blank is the recommended default for a single-user Pi deploy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Comma-separated allowlist for GET /auth/{provider}/authorize's redirect
# target (`redirect_uri`) — see app/api/routes_auth.py's oauth flow. The
# native iOS/Android app uses the `expoeducationassistant://` scheme;
# the web bundle uses an HTTP origin. One HTTP entry per web origin the
# app might be served from. rpi5-setup.sh expands `<PI_LAN_HOST>` here too.
ALLOWED_AUTH_REDIRECT_URIS=expoeducationassistant://auth-callback,http://localhost:8081/auth-callback,http://127.0.0.1:8081/auth-callback

# --- Auth: dev-only test login ---
# Hard-refused when APP_ENV=production regardless of this flag
# (`routes_auth.py:55`), but setting it explicitly false is a belt-and-
# suspenders guard against an accidental configuration change.
AUTH_DEV_LOGIN_ENABLED=true

# --- Frontend base URL (drives OAuth redirect_uri validation, not CORS) ---
FRONTEND_URL=http://localhost:8081

# Legacy document backfill — leave blank unless an operator is
# explicitly running `python -m cli.documents adopt-legacy`. Leaving it
# blank documents (predating per-user scoping) stay hidden, never
# globally exposed, in the meantime.
DEV_LEGACY_OWNER_USER_ID=

# --- Retrieval / context-prep tuning ---
# Defaults match app/config.py and are well-tuned for the standard
# qwen3:4b + mxbai-embed-large pair. Touch only after re-running the
# retrieval/answer eval against this specific Pi's actual ingested
# corpus; calibration numbers are not portable across hardware.
RETRIEVAL_TOP_K=8
RETRIEVAL_FETCH_K=24
RETRIEVAL_MMR_RELEVANCE_WEIGHT=0.7
RETRIEVAL_MIN_SCORE=
CONTEXT_MAX_CHUNKS_PER_DOCUMENT=3
CONTEXT_MAX_TOTAL_CHARS=8000
CONTEXT_DEDUP_SIMILARITY_THRESHOLD=0.92

# --- Rate limiting (per-process; protects /conversations/{id}/messages ---
# from a single caller flooding the LLM-backed stream endpoint) ---
CHAT_RATE_LIMIT_MAX_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
FRONTEND_PORT=8081
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
