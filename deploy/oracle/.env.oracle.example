# ============================================================================
# Oracle Cloud VM.Standard.A1.Flex deployment env file template.
# ============================================================================
#
# DO NOT USE this file directly — copy it to `.env.oracle` and fill in the
# placeholders marked `<...>`. `.env.oracle` holds real secrets (JWT_SECRET,
# OAuth client secrets) and is git-ignored; this `.example` file is the only
# one of the two ever committed. See deploy/oracle/README.md for the full
# first-time setup walkthrough.
#
# Target host profile: Oracle VM.Standard.A1.Flex, ARM64, 4 OCPUs, 24 GB RAM
# — see deploy/oracle/docker-compose.oracle.yml for the resource limits
# tuned for that shape, and deploy/oracle/README.md for why they're set the
# way they are (this profile has ~3-4x the CPU quota and headroom the
# original Raspberry Pi 5 config assumed).
#
# Every key below has been verified against `app/config.py`'s field names;
# the pydantic-settings mapping is snake_case in code -> UPPER_SNAKE_CASE in
# the environment.

# --- Runtime mode ---
# production hard-refuses /auth/dev-login regardless of AUTH_DEV_LOGIN_ENABLED
# (see app/api/routes_auth.py) — set this to `production` once you are past
# initial testing and have real OAuth providers configured below. See the
# README's Security Guidance section.
APP_ENV=production
LOG_LEVEL=INFO

# --- Bind address inside the container (Compose publishes 8000 to host) ---
HOST=0.0.0.0
PORT=8000

# --- CORS allowlist: exact-string match per app/main.py CORSMiddleware ---
# List every concrete origin the web bundle might be opened from (port
# included — different port = different origin). No wildcards in
# production. edum8.us is the canonical frontend origin (OAuth completion
# and every post-login redirect resolve against it — see FRONTEND_URL and
# ALLOWED_AUTH_REDIRECT_URIS below); app.edum8.us is an alternate frontend
# origin allowed to call this API but is NOT used as an OAuth redirect
# target. Replace with your own domain(s) if not deploying edum8.us itself.
CORS_ORIGINS=https://edum8.us,https://www.edum8.us,https://app.edum8.us

# --- Ollama (sibling container on the compose-internal network) ---
OLLAMA_BASE_URL=http://ollama:11434

# The 24 GB / 4 OCPU Oracle host runs the larger desktop-dev model sizes
# comfortably (unlike the 8 GB Raspberry Pi 5 config this file was
# originally derived from, which needed the smaller qwen3:4b / qwen2.5vl:3b
# pair). See README.md's "Model configuration" section for the reasoning.
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=mxbai-embed-large

# --- Performance tuning (see README.md's "Performance optimizations") ---
# Whether qwen3 runs with its hidden "thinking" reasoning trace. Off by
# default: on this CPU-only host, thinking tokens routinely dwarf the
# visible answer and add tens of seconds of latency for no user-visible
# benefit (see app/core/llm_provider.py's OllamaLLMProvider `think` param).
OLLAMA_THINKING_ENABLED=false
# Caps completion length (Ollama's `num_predict` chat option) so a
# pathological/looping generation can't run unbounded. 512 is generous for
# a citation-grounded RAG answer.
OLLAMA_NUM_PREDICT=512
# How many chunks app/core/document_ingestion_jobs.py groups into one
# embedding request during document ingestion. 32 matches
# OllamaEmbeddingProvider's own internal batching ceiling.
EMBEDDING_BATCH_SIZE=32
# Not read by the backend app itself — only by
# deploy/oracle/scripts/oracle-prewarm-model.sh, invoked from
# oracle-start.sh after the post-start health check passes. When true, a
# single minimal chat request (think=false, output discarded) is sent to
# OLLAMA_LLM_MODEL right after startup, so the model is already loaded into
# memory before the first real user request arrives — a cold qwen3:8b load
# alone was measured at ~44s on this CPU-only host. A prewarm failure only
# logs a warning; it never blocks startup or the app's normal (slower)
# first-request behavior. Off by default since it adds ~tens of seconds to
# every (re)start for a benefit that only matters for the very first chat
# after a restart.
OLLAMA_PREWARM_ENABLED=false
# Optional override for oracle-prewarm-model.sh/oracle-start.sh — how
# many models Ollama keeps resident simultaneously. A live investigation
# measured qwen3:8b+qwen2.5vl:7b resident together at ~11.7GB and
# qwen3:8b+qwen2.5vl:3b at ~9.1GB, both comfortably under this
# deployment's 18GB Ollama memory limit (docker-compose.oracle.yml) —
# meaning the default of 2 is a model-*count* limit, not one this host's
# memory actually requires. Uncomment and raise to 3 only if your traffic
# actually interleaves text + vision + embedding requests and you've
# confirmed (see oracle-status.sh / `ollama ps`) that isn't causing
# problems for your specific model set — see README.md's "Model
# residency" section. Left commented rather than defaulted to 3 here:
# this task's investigation measured, but did not change, this value.
# OLLAMA_MAX_LOADED_MODELS=2

# --- Vision pipeline (the same path as the text model — the dedicated ---
# --- vision LLM is what does multimodal message understanding). ---
VISION_ENABLED=true
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Caps/latency tuning.
VISION_MAX_IMAGES_PER_MESSAGE=4
VISION_MAX_IMAGE_BYTES=10485760
VISION_MAX_PDF_PAGES=10
# Bounds *time-to-first-token* only (cold model load + prompt/image
# evaluation combined — see app/config.py's vision_request_timeout_seconds
# docstring for why these can't be split). Raised from an original 180 —
# a live measurement on this CPU-only Oracle host found qwen2.5vl:7b
# prompt-evaluation alone taking 114-232+ seconds even fully warm for a
# single modest image, already past the old 180s default with the model
# warm. This is the direct root cause behind this deployment's "did not
# respond in time" production error.
VISION_REQUEST_TIMEOUT_SECONDS=300
# Separate, materially tighter budget for a stall *after* generation has
# already started producing output — see
# app/config.py's vision_generation_timeout_seconds docstring.
VISION_GENERATION_TIMEOUT_SECONDS=60
# Longest side (pixels) an image sent to the vision model may have,
# downscaled if larger. Lowered from an original 1568: the same live
# measurement found prompt-eval time tracks image token count, which
# tracks pixel count (a 640x360 image measured ~114s vs. a 1568-capped
# ~1568x882 image at ~232s) — 1024 cuts worst-case pixel area by more
# than half while remaining legible for document text and typical
# screenshot UI.
VISION_MAX_IMAGE_DIMENSION=1024
# Defense-in-depth safety limits, checked before ever calling Ollama (see
# app/services/vision_service.py) — not measured/tuned individually
# during this task's investigation, set to generous values that should
# never trigger for a normal attachment while still catching a
# pathological one (e.g. a decompression-bomb-style image, or a
# multi-image message whose combined pixel count would dwarf any single
# image's own limit).
VISION_MAX_IMAGE_PIXELS=20000000
VISION_MAX_TOTAL_PIXELS=60000000
VISION_MAX_PROMPT_CHARS=20000
# Caps completion length (Ollama's `num_predict`) for a vision reply —
# vision had no cap at all before this; mirrors OLLAMA_NUM_PREDICT above
# for the text pipeline.
VISION_NUM_PREDICT=512
# Off by default, independent of OLLAMA_PREWARM_ENABLED above — see
# "Ollama model prewarm" in README.md. A vision cold-load was measured
# noticeably slower than text's, so this can meaningfully help the first
# post-restart vision-attachment message, at the cost of ~tens of seconds
# to every (re)start and — since OLLAMA_MAX_LOADED_MODELS defaults to 2
# — a real chance of evicting the just-prewarmed text model (reported by
# oracle-prewarm-model.sh when it happens, never silent).
OLLAMA_VISION_PREWARM_ENABLED=false

# --- Image generation ---
# Off by default: x/flux2-klein is a multi-GB additional model pull and
# multi-second-per-image generation on CPU-only hardware. The frontend
# auto-hides image-gen UI when this is false, and every POST /images/*
# returns 404 because the router isn't mounted.
IMAGE_GENERATION_ENABLED=false
# Kept for symmetry with .env.example; unused as long as the line above
# is false. Override only if IMAGE_GENERATION_ENABLED is flipped to true.
OLLAMA_IMAGE_MODEL=x/flux2-klein
IMAGE_GENERATION_REQUEST_TIMEOUT_SECONDS=300
IMAGE_GENERATION_MAX_IMAGES=4

# --- Evidence analysis / NLI shadow infrastructure (Milestone 11) ---
# Master kill switch for the whole evidence-analysis track (see
# app/core/evidence_eligibility.py and app/core/evidence_shadow.py) —
# false means the backend never calls the evidence-service container at
# all, regardless of every other setting below. MUST remain false here
# after Milestone 11: that milestone builds and validates the shadow
# infrastructure but does NOT turn it on — see the Milestone 11 report
# §25/§28 for the PO's activation decision. Do not flip this to true as
# part of a routine deploy; it is a deliberate, separate operational
# decision.
EVIDENCE_ANALYSIS_ENABLED=false
# "off" | "shadow" | "zoom_in_enforced" — "zoom_in_enforced" has NO
# implemented behavior yet (Milestone 11 §24) and is treated identically
# to "off" regardless of this value; only "shadow" does anything, and
# only once EVIDENCE_ANALYSIS_ENABLED=true above.
EVIDENCE_ANALYSIS_MODE=off
# Fraction (0.0-1.0) of Zoom-In-eligible, claim-applicable requests that
# run shadow verification when the two settings above are both on.
# Milestone 10 §37's approved starting value.
EVIDENCE_ANALYSIS_SAMPLE_RATE=0.05
# Internal Docker-network-only URL — matches
# deploy/oracle/docker-compose.oracle.yml's `evidence-service` service
# name/port exactly; override only if that service is ever renamed.
EVIDENCE_SERVICE_URL=http://evidence-service:8100
# Client-side budget (Milestone 10 §30) — the evidence-service's own
# internal timeout is set slightly lower (see evidence-service/app/
# config.py) so its own overload/timeout response reaches the backend
# before this deadline would otherwise fire first.
EVIDENCE_SERVICE_TIMEOUT_MS=2500

# --- Authoritative bibliographic metadata enrichment (Milestone 4.1) ---
# Master kill switch — false means the backend never calls Crossref (or
# any future provider) at all, and document upload/ingestion never
# depends on it either way. Same "ships false, a deliberate separate
# operational decision" convention as EVIDENCE_ANALYSIS_ENABLED above —
# see app/core/bibliographic_enrichment_service.py.
#
# MUST remain false here until BIBLIOGRAPHIC_PROVIDER_CONTACT_EMAIL below
# is a real, monitored EduM8 operations address (e.g. api@edum8.us) —
# Crossref's own "polite pool" convention expects that contact to
# actually reach a human. Do NOT set it to a no-reply/placeholder/personal
# address; leave enrichment disabled until a monitored address exists
# (Milestone 4.1 production rollout, 2026-08-15 decision).
BIBLIOGRAPHIC_ENRICHMENT_ENABLED=false

# --- Secure LaTeX compilation (Milestone 5.1) ---
# Master kill switch — false means POST /writing-projects/{id}/compile
# (and the PDF-download route) 404 identically to a disabled feature
# elsewhere in this app, and the Writing editor's Compile button/PDF
# preview stay hidden (GET /status surfaces this same flag). MUST remain
# false here until Milestone 5.1's full security validation (threat
# model, container hardening — non-root, read-only rootfs, no-shell-
# escape, internet-isolated network — malicious-fixture suite, host-
# resilience test) has been reviewed and a human operator deliberately
# flips it. Do not set this to true as part of a routine deploy.
LATEX_COMPILATION_ENABLED=false
# Internal Docker-network-only URL — matches
# deploy/oracle/docker-compose.oracle.yml's `latex-compiler` service
# name/port exactly; override only if that service is ever renamed.
LATEX_COMPILER_URL=http://latex-compiler:8200
# Client-side budget — a little above the compiler service's own
# internal job_timeout_seconds default (45s) so that service's own
# timeout response reaches the backend before this deadline would
# otherwise fire first.
LATEX_COMPILER_TIMEOUT_SECONDS=55
# --- Writing Project files (Milestone 5.3), on /data — the SAME Docker
# named volume `backend-data` already backed up by oracle-backup.sh, no
# backup-script change needed. MUST be an absolute path under /data —
# the config default ("./data/writing-project-files") is relative to
# the backend container's CWD (/app), which is the container's
# EPHEMERAL writable layer, NOT the persistent volume; every uploaded
# project figure/style-file would silently vanish on the next container
# recreate if this were left unset. Found and fixed during the M5.3
# production-rollout preflight (2026-08-16) before any project files
# existed in production — same class of check DOCUMENT_STORAGE_DIR
# above already required.
WRITING_PROJECT_FILES_DIR=/data/writing-project-files
# Milestone 5.4 (LaTeX Templates & Project Import) — the SAME bug class
# as WRITING_PROJECT_FILES_DIR above: the config default
# ("./data/writing-import-staging") is relative to the backend
# container's CWD (the ephemeral layer), not the persistent volume.
# writing_import_sessions rows in the database are persistent and
# TTL-bound (30 min default); if the staged ZIP bytes they reference
# lived on the ephemeral layer instead, a container restart mid-window
# would leave a session row pointing at bytes that no longer exist —
# self-healing (the row expires within the TTL and the user just
# re-uploads) but needlessly sloppy. Found and fixed during the M5.4
# production-rollout preflight (2026-08-16), before this milestone's
# code was ever deployed — proactively applying the same fix rather
# than waiting to rediscover the identical bug class.
WRITING_IMPORT_STAGING_DIR=/data/writing-import-staging
# Milestone 5.5 Part 22 — same bug class as WRITING_PROJECT_FILES_DIR/
# WRITING_IMPORT_STAGING_DIR above: the config default
# ("./data/compile-artifacts") is relative to the backend container's CWD
# (the ephemeral layer), not the persistent volume. Replaces the old
# in-process compile_artifact_cache.py, which was invisible across this
# deployment's 2 uvicorn workers (--workers 2 below) — a compile POST on
# worker A and the follow-up PDF GET on worker B could silently 404. Must
# resolve under the SAME backend-data volume as the dirs above, for the
# same reason.
COMPILE_ARTIFACT_DIR=/data/compile-artifacts
BIBLIOGRAPHIC_PROVIDER_BASE_URL=https://api.crossref.org
# See the note above — must be a real, monitored @edum8.us address before
# BIBLIOGRAPHIC_ENRICHMENT_ENABLED is ever flipped to true.
BIBLIOGRAPHIC_PROVIDER_CONTACT_EMAIL=support@example.com
BIBLIOGRAPHIC_PROVIDER_TIMEOUT_SECONDS=5.0

# --- Chat attachments (on /data — Docker named volume `backend-data`) ---
CHAT_ATTACHMENTS_DIR=/data/chat-attachments
CHAT_ATTACHMENT_MAX_BYTES=10485760
CHAT_ATTACHMENT_MAX_FILES_PER_MESSAGE=5
CHAT_ATTACHMENT_MAX_PDF_PAGES=50
CHAT_ATTACHMENT_ALLOW_HEIC=false

# --- Original document files (Frontend Milestone 3.1 — Original Document
# Reader), on /data — the SAME Docker named volume `backend-data` already
# backed up by oracle-backup.sh (see that script's "backend-data" volume
# tar step) — no backup-script change was needed for this milestone.
DOCUMENT_STORAGE_DIR=/data/document-files

# --- Qdrant ---
# `server` mode because Qdrant runs as its own container; `local` mode
# would mean the backend embeds a second Qdrant for no reason. `qdrant` is
# the compose-internal hostname — Docker's network DNS resolves it.
QDRANT_MODE=server
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=education_research

# --- Database (sqlite at /data/app.db — see backend-data volume) ---
# Four slashes: three for the URL scheme's `///` (absolute path) plus the
# leading slash of `/data/app.db`. Critical — sqlite sqlalchemy interprets
# `sqlite:///relative.db` and `sqlite:////data/app.db` differently (the
# latter is absolute).
DATABASE_URL=sqlite:////data/app.db

# --- Auth: JWT signing secret ---
# Required; the pydantic validator refuses any value shorter than 16
# characters (see app/config.py's jwt_secret: Field(min_length=16)).
# Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# DO NOT hand-write or reuse a value committed to git history.
JWT_SECRET=<GENERATE_A_RANDOM_SECRET>
JWT_ACCESS_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# --- Auth: local email/password sign-in ---
# On by default: POST /auth/register and POST /auth/login work out of the
# box with no external credentials to configure, independent of every
# OAuth provider setting below (see ProvidersResponse.local_auth_enabled
# in app/schemas/auth.py) — set false only to force Google-only sign-in.
AUTH_LOCAL_LOGIN_ENABLED=true
# Sliding-window rate limits for POST /auth/login and POST /auth/register
# (app/core/auth_rate_limiter.py — DB-backed, safe across this
# deployment's multiple uvicorn workers, unlike the in-memory chat
# limiter below). Login gets more attempts over a shorter window than
# registration since a mistyped password is normal; registration is rarer
# and cheaper to throttle harder.
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_REGISTER_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
# Sliding-window rate limits for POST /auth/verify-email (protects against
# brute-forcing a token value; per-IP only, no account is known until the
# token is looked up) and POST /auth/resend-verification (protects an
# address from being mail-bombed).
AUTH_VERIFY_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_VERIFY_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RESEND_VERIFICATION_RATE_LIMIT_MAX_ATTEMPTS=3
AUTH_RESEND_VERIFICATION_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Auth: email verification ---
# On by default — a newly-registered local account must confirm its
# address (see POST /auth/verify-email) before POST /auth/login will
# issue real tokens for it. Never affects OAuth accounts, which get their
# verified-email status directly from the provider. Set false only for a
# self-hosted/single-operator deployment that doesn't want this friction —
# see README's "Local authentication" section for exactly what changes.
AUTH_EMAIL_VERIFICATION_REQUIRED=true

# --- Auth: OAuth providers ---
# All blank by default — the login screen's "Continue with …" buttons
# disappear entirely when no providers are configured (see
# app/api/routes_auth.py's providers response); local email/password
# sign-in above is unaffected either way. See README's "Google/Facebook/
# LinkedIn OAuth setup" sections for the exact provider-console values
# (authorized origins, redirect URI, scopes) to enter for each.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.edum8.us/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://api.edum8.us/auth/facebook/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.edum8.us/auth/linkedin/callback

# Comma-separated allowlist for GET /auth/{provider}/authorize's redirect
# target (redirect_uri) — see app/api/routes_auth.py's oauth flow. The
# native iOS/Android app uses the `expoeducationassistant://` scheme; the
# web bundle uses edum8.us's own /auth-callback route (the canonical
# frontend — see FRONTEND_URL below). app.edum8.us is deliberately NOT
# listed here: it may call this API (see CORS_ORIGINS) but is not a valid
# OAuth completion target, keeping exactly one redirect surface to secure.
ALLOWED_AUTH_REDIRECT_URIS=expoeducationassistant://auth-callback,https://edum8.us/auth-callback

# --- Auth: dev-only test login ---
# TEMPORARY TESTING ONLY. Hard-refused when APP_ENV=production regardless
# of this flag (routes_auth.py:55), but it must be false before this
# deployment is used for anything beyond your own testing — see README.md's
# Security Guidance section. Bearing a real user base on dev-login is not a
# supported configuration.
AUTH_DEV_LOGIN_ENABLED=false

# --- Frontend base URL (drives OAuth redirect_uri validation, not CORS) ---
# The canonical frontend — see README's "Canonical frontend" note for why
# edum8.us (not app.edum8.us) is the one OAuth completes against.
FRONTEND_URL=https://edum8.us

# This backend's own publicly-reachable base URL — used to build the
# absolute link inside a verification email (GET {this}/auth/verify-email
# ?token=...). Deliberately a separate setting from FRONTEND_URL (that's
# edum8.us, the frontend's own domain) — this is api.edum8.us. Not derived
# from the incoming request because uvicorn runs here without
# --proxy-headers (see docker-compose.oracle.yml), so it would otherwise
# see only Caddy's loopback connection, never the real public host.
BACKEND_PUBLIC_URL=https://api.edum8.us

# --- Email delivery (account verification; any future password-reset) ---
# "console" (the default) never actually sends anything — it only logs a
# subject/recipient line, and is hard-refused outright at startup whenever
# APP_ENV=production (see app/config.py's refuse_dev_email_backend_in_
# production, called from app/main.py) — you MUST set EMAIL_PROVIDER=smtp
# and fill in the SMTP_* values below before deploying with
# APP_ENV=production, or the backend process will not start.
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=EduM8
EMAIL_FROM_ADDRESS=no-reply@edum8.us
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# See README's "Email delivery (SMTP) setup" section for provider-specific
# guidance and the SPF/DKIM/DMARC DNS records edum8.us needs for
# deliverability. DO NOT commit a real SMTP_PASSWORD value anywhere.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Legacy document backfill — leave blank unless an operator is explicitly
# running `python -m cli.documents adopt-legacy`.
DEV_LEGACY_OWNER_USER_ID=

# --- Retrieval / context-prep tuning ---
# Defaults match app/config.py. Chunk overlap (200, down from an earlier
# 450) is set in code (app/ingestion/chunker.py's
# DEFAULT_CHUNK_OVERLAP_CHARS), not here — see README.md's "Performance
# optimizations" for why 200 was chosen and what the retrieval-quality
# evaluation found.
#
# A live text-RAG prompt-prefill investigation (see README.md's "Text RAG
# prompt-prefill" section) found prompt evaluation the dominant cost of a
# chat turn on this CPU host — 161.9s of a 198.2s total for one real
# 2,640-token prompt, ~16.3 tokens/second prefill throughput — and found
# that RETRIEVAL_TOP_K=3 / CONTEXT_MAX_TOTAL_CHARS=3500 cut a comparable
# prompt from ~2,600 to ~1,150 tokens and cut measured prompt-evaluation
# time from ~164s to ~3.75s in a clean (uncontended) run — a much larger
# reduction than token count alone predicts, and not fully reproducible on
# every run (contended runs on this shared host still showed ~50s) — see
# that section for the full measured range. Quality was spot-checked
# (insufficient-evidence honesty and factual/citation accuracy both held
# up) but not exhaustively re-validated against every question in this
# corpus. Left at the original values below rather than changed here —
# this task's investigation measured and recommends, but does not force,
# this change; uncomment the two lines below to apply it.
RETRIEVAL_TOP_K=8
# RETRIEVAL_TOP_K=3
RETRIEVAL_FETCH_K=24
RETRIEVAL_MMR_RELEVANCE_WEIGHT=0.7
RETRIEVAL_MIN_SCORE=
CONTEXT_MAX_CHUNKS_PER_DOCUMENT=3
CONTEXT_MAX_TOTAL_CHARS=8000
# CONTEXT_MAX_TOTAL_CHARS=3500
CONTEXT_DEDUP_SIMILARITY_THRESHOLD=0.92

# --- RAG prompt shape (same investigation) ---
# rag_prompt_variant="compact" (app/core/prompt_builder.py) cuts the
# always-sent system prompt from 2,600 to 1,310 characters (measured —
# see README.md) by tightening wording and making the project-context
# paragraph conditional (only sent when a project actually has approved
# context, mirroring what the vision prompt already did) — no rule was
# removed, only reworded more compactly; see README.md's audit table for
# the line-by-line justification. Spot-checked for quality (citation
# format, insufficient-evidence honesty) with no regression found in a
# small sample. Left at "current" (the original, unabridged prompt)
# rather than changed here, same reasoning as RETRIEVAL_TOP_K above.
RAG_PROMPT_VARIANT=current
# RAG_PROMPT_VARIANT=compact
# rag_source_order="stable" sorts the final selected sources by
# (document_id, chunk_index) instead of relevance rank — never changes
# *which* chunks are selected, only their order in the prompt, so this is
# risk-free for correctness. Intended to help Ollama's prompt-cache reuse
# a shared prefix across two requests whose retrieved chunks overlap, but
# this investigation's own test (repeating one identical prompt back to
# back) found that cache reuse is NOT reliable on this shared, contended
# host — the identical repeat took 50s the second time, not near-zero.
# Safe to enable (it cannot make things worse) but should not be counted
# on for a guaranteed latency win.
RAG_SOURCE_ORDER=relevance
# RAG_SOURCE_ORDER=stable

# --- Rate limiting (per-process; protects /conversations/{id}/messages ---
# from a single caller flooding the LLM-backed stream endpoint) ---
CHAT_RATE_LIMIT_MAX_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend build/runtime ---
# 8000 (backend) and 8080 (frontend) are published to 127.0.0.1 only (see
# docker-compose.oracle.yml) — never reachable directly from outside the
# VM. Caddy terminates HTTPS on 80/443 and reverse-proxies to these two
# loopback ports; Cloudflare sits in front of Caddy. Neither this file nor
# docker-compose.oracle.yml configures Caddy/Cloudflare themselves — see
# README.md for where that lives.
FRONTEND_PORT=8080
EXPO_PUBLIC_API_BASE_URL=https://api.edum8.us
