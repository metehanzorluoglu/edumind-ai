# ============================================================================
# Oracle Cloud VM.Standard.A1.Flex deployment env file template.
# ============================================================================
#
# DO NOT USE this file directly — copy it to `.env.oracle` and fill in the
# placeholders marked `<...>`. `.env.oracle` holds real secrets (JWT_SECRET,
# OAuth client secrets) and is git-ignored; this `.example` file is the only
# one of the two ever committed. See deploy/oracle/README.md for the full
# first-time setup walkthrough.
#
# Target host profile: Oracle VM.Standard.A1.Flex, ARM64, 4 OCPUs, 24 GB RAM
# — see deploy/oracle/docker-compose.oracle.yml for the resource limits
# tuned for that shape, and deploy/oracle/README.md for why they're set the
# way they are (this profile has ~3-4x the CPU quota and headroom the
# original Raspberry Pi 5 config assumed).
#
# Every key below has been verified against `app/config.py`'s field names;
# the pydantic-settings mapping is snake_case in code -> UPPER_SNAKE_CASE in
# the environment.

# --- Runtime mode ---
# production hard-refuses /auth/dev-login regardless of AUTH_DEV_LOGIN_ENABLED
# (see app/api/routes_auth.py) — set this to `production` once you are past
# initial testing and have real OAuth providers configured below. See the
# README's Security Guidance section.
APP_ENV=production
LOG_LEVEL=INFO

# --- Bind address inside the container (Compose publishes 8000 to host) ---
HOST=0.0.0.0
PORT=8000

# --- CORS allowlist: exact-string match per app/main.py CORSMiddleware ---
# List every concrete origin the web bundle might be opened from (port
# included — different port = different origin). Replace
# <ORACLE_PUBLIC_IP> with the VM's real public IP (or domain name once one
# is pointed at it).
CORS_ORIGINS=http://<ORACLE_PUBLIC_IP>:8080

# --- Ollama (sibling container on the compose-internal network) ---
OLLAMA_BASE_URL=http://ollama:11434

# The 24 GB / 4 OCPU Oracle host runs the larger desktop-dev model sizes
# comfortably (unlike the 8 GB Raspberry Pi 5 config this file was
# originally derived from, which needed the smaller qwen3:4b / qwen2.5vl:3b
# pair). See README.md's "Model configuration" section for the reasoning.
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=mxbai-embed-large

# --- Performance tuning (see README.md's "Performance optimizations") ---
# Whether qwen3 runs with its hidden "thinking" reasoning trace. Off by
# default: on this CPU-only host, thinking tokens routinely dwarf the
# visible answer and add tens of seconds of latency for no user-visible
# benefit (see app/core/llm_provider.py's OllamaLLMProvider `think` param).
OLLAMA_THINKING_ENABLED=false
# Caps completion length (Ollama's `num_predict` chat option) so a
# pathological/looping generation can't run unbounded. 512 is generous for
# a citation-grounded RAG answer.
OLLAMA_NUM_PREDICT=512
# How many chunks app/core/document_ingestion_jobs.py groups into one
# embedding request during document ingestion. 32 matches
# OllamaEmbeddingProvider's own internal batching ceiling.
EMBEDDING_BATCH_SIZE=32
# Not read by the backend app itself — only by
# deploy/oracle/scripts/oracle-prewarm-model.sh, invoked from
# oracle-start.sh after the post-start health check passes. When true, a
# single minimal chat request (think=false, output discarded) is sent to
# OLLAMA_LLM_MODEL right after startup, so the model is already loaded into
# memory before the first real user request arrives — a cold qwen3:8b load
# alone was measured at ~44s on this CPU-only host. A prewarm failure only
# logs a warning; it never blocks startup or the app's normal (slower)
# first-request behavior. Off by default since it adds ~tens of seconds to
# every (re)start for a benefit that only matters for the very first chat
# after a restart.
OLLAMA_PREWARM_ENABLED=false

# --- Vision pipeline (the same path as the text model — the dedicated ---
# --- vision LLM is what does multimodal message understanding). ---
VISION_ENABLED=true
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Caps/latency tuning — defaults already conservative.
VISION_MAX_IMAGES_PER_MESSAGE=4
VISION_MAX_IMAGE_BYTES=10485760
VISION_MAX_PDF_PAGES=10
VISION_REQUEST_TIMEOUT_SECONDS=180

# --- Image generation ---
# Off by default: x/flux2-klein is a multi-GB additional model pull and
# multi-second-per-image generation on CPU-only hardware. The frontend
# auto-hides image-gen UI when this is false, and every POST /images/*
# returns 404 because the router isn't mounted.
IMAGE_GENERATION_ENABLED=false
# Kept for symmetry with .env.example; unused as long as the line above
# is false. Override only if IMAGE_GENERATION_ENABLED is flipped to true.
OLLAMA_IMAGE_MODEL=x/flux2-klein
IMAGE_GENERATION_REQUEST_TIMEOUT_SECONDS=300
IMAGE_GENERATION_MAX_IMAGES=4

# --- Chat attachments (on /data — Docker named volume `backend-data`) ---
CHAT_ATTACHMENTS_DIR=/data/chat-attachments
CHAT_ATTACHMENT_MAX_BYTES=10485760
CHAT_ATTACHMENT_MAX_FILES_PER_MESSAGE=5
CHAT_ATTACHMENT_MAX_PDF_PAGES=50
CHAT_ATTACHMENT_ALLOW_HEIC=false

# --- Qdrant ---
# `server` mode because Qdrant runs as its own container; `local` mode
# would mean the backend embeds a second Qdrant for no reason. `qdrant` is
# the compose-internal hostname — Docker's network DNS resolves it.
QDRANT_MODE=server
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=education_research

# --- Database (sqlite at /data/app.db — see backend-data volume) ---
# Four slashes: three for the URL scheme's `///` (absolute path) plus the
# leading slash of `/data/app.db`. Critical — sqlite sqlalchemy interprets
# `sqlite:///relative.db` and `sqlite:////data/app.db` differently (the
# latter is absolute).
DATABASE_URL=sqlite:////data/app.db

# --- Auth: JWT signing secret ---
# Required; the pydantic validator refuses any value shorter than 16
# characters (see app/config.py's jwt_secret: Field(min_length=16)).
# Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# DO NOT hand-write or reuse a value committed to git history.
JWT_SECRET=<GENERATE_A_RANDOM_SECRET>
JWT_ACCESS_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# --- Auth: OAuth providers ---
# All blank by default — the Settings screen's "Continue with …" buttons
# disappear entirely when no providers are configured (see
# app/api/routes_auth.py's providers response). Required before setting
# APP_ENV=production for real use (see README's Security Guidance).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Comma-separated allowlist for GET /auth/{provider}/authorize's redirect
# target (redirect_uri) — see app/api/routes_auth.py's oauth flow. The
# native iOS/Android app uses the `expoeducationassistant://` scheme; the
# web bundle uses an HTTP origin.
ALLOWED_AUTH_REDIRECT_URIS=expoeducationassistant://auth-callback,http://<ORACLE_PUBLIC_IP>:8080/auth-callback

# --- Auth: dev-only test login ---
# TEMPORARY TESTING ONLY. Hard-refused when APP_ENV=production regardless
# of this flag (routes_auth.py:55), but it must be false before this
# deployment is used for anything beyond your own testing — see README.md's
# Security Guidance section. Bearing a real user base on dev-login is not a
# supported configuration.
AUTH_DEV_LOGIN_ENABLED=false

# --- Frontend base URL (drives OAuth redirect_uri validation, not CORS) ---
FRONTEND_URL=http://<ORACLE_PUBLIC_IP>:8080

# Legacy document backfill — leave blank unless an operator is explicitly
# running `python -m cli.documents adopt-legacy`.
DEV_LEGACY_OWNER_USER_ID=

# --- Retrieval / context-prep tuning ---
# Defaults match app/config.py. Chunk overlap (200, down from an earlier
# 450) is set in code (app/ingestion/chunker.py's
# DEFAULT_CHUNK_OVERLAP_CHARS), not here — see README.md's "Performance
# optimizations" for why 200 was chosen and what the retrieval-quality
# evaluation found.
RETRIEVAL_TOP_K=8
RETRIEVAL_FETCH_K=24
RETRIEVAL_MMR_RELEVANCE_WEIGHT=0.7
RETRIEVAL_MIN_SCORE=
CONTEXT_MAX_CHUNKS_PER_DOCUMENT=3
CONTEXT_MAX_TOTAL_CHARS=8000
CONTEXT_DEDUP_SIMILARITY_THRESHOLD=0.92

# --- Rate limiting (per-process; protects /conversations/{id}/messages ---
# from a single caller flooding the LLM-backed stream endpoint) ---
CHAT_RATE_LIMIT_MAX_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend build/runtime ---
# TEMPORARY TESTING PORTS. 8000 (backend) and 8080 (frontend) are exposed
# directly on the host for initial setup and testing — see README.md's
# Security Guidance section for why a final production deployment should
# instead expose only 80/443 through a reverse proxy in front of this
# stack, not these two ports directly.
FRONTEND_PORT=8080
EXPO_PUBLIC_API_BASE_URL=http://<ORACLE_PUBLIC_IP>:8000
