# Used only by scripts/generate-api-types.ts and scripts/live-smoke-test.ts —
# the built SDK itself takes baseUrl/token as constructor arguments at runtime,
# never from environment variables (see README.md "Secret handling").

# Base URL of a locally running rag-backend instance (see ../../rag-backend).
EAC_BACKEND_URL=http://localhost:8000

# A real API key from that backend's .env, used only for the live smoke test
# and for fetching /openapi.json during codegen. Never commit a real value.
EAC_API_KEY=change-me
